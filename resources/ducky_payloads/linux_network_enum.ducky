REM Linux network enumeration to a file in the home dir (net_enum.txt).
REM Authorized testing only. Assumes a GNOME-style Ctrl+Alt+T terminal.
DELAY 1000
CTRL ALT t
DELAY 1500
STRING { ip -brief addr; echo; ip route; echo; cat /etc/resolv.conf; echo; (ss -tulpn || netstat -tulpn); echo; arp -n; } > ~/net_enum.txt 2>&1
ENTER
