REM Linux privilege-escalation surface audit to the home dir (privesc.txt).
REM Authorized testing only — sudo rights, SUID files, cron, writable paths.
DELAY 1000
CTRL ALT t
DELAY 1500
STRING { id; echo; sudo -n -l 2>&1; echo; find / -perm -4000 -type f 2>/dev/null; echo; ls -la /etc/cron* 2>/dev/null; cat /etc/crontab 2>/dev/null; } > ~/privesc.txt 2>&1
ENTER
