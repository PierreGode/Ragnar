[Unit]
# Ragnar legacywatch — passive 802.11 legacy-PHY / cipher / airtime detector.
# OPT-IN. RX-only: it never transmits and never touches radio state. Granted
# CAP_NET_RAW only (open a monitor socket read-only) — NOT CAP_NET_ADMIN, so it
# cannot set monitor mode, channel or hop. YOU prepare the interface first:
#   sudo ip link set wlan1 down && sudo iw dev wlan1 set type monitor
#   sudo ip link set wlan1 up  && sudo iw dev wlan1 set channel 6
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin legacymon
#   sudo mkdir -p /var/log/legacywatch && sudo chown legacymon:legacymon /var/log/legacywatch
#   sudo install -Dm644 python/legacywatch.example.json /etc/ragnar/legacywatch.json
#   sudo cp scripts/legacywatch.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/legacywatch.service   # set RAGNAR_LEGACY_IFACE
#   sudo systemctl enable --now legacywatch
#   journalctl -u legacywatch -f
Description=Ragnar legacywatch passive 802.11 legacy/cipher/airtime detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=legacymon
Group=legacymon
WorkingDirectory=/home/ragnar/Ragnar/python
Environment=RAGNAR_LEGACY_IFACE=wlan1
ExecStartPre=/bin/mkdir -p /var/log/legacywatch
ExecStart=/usr/bin/python3 /home/ragnar/Ragnar/python/legacywatch.py \
    -i ${RAGNAR_LEGACY_IFACE} -c /etc/ragnar/legacywatch.json \
    --jsonl /var/log/legacywatch/alerts.jsonl
Restart=on-failure
RestartSec=5

# --- least privilege: sniff only (never sets radio state) -----------------
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/legacywatch
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
LockPersonality=yes
MemoryMax=192M

[Install]
WantedBy=multi-user.target
