[Unit]
Description=certwatch - passive TLS certificate triage (Ragnar)
Documentation=https://github.com/<you>/ragnar/tree/lcdhat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust interface (tap/SPAN/bridge) and options to taste.
ExecStart=/usr/bin/python3 /opt/ragnar/certwatch.py -i mon0 --json
Restart=on-failure
RestartSec=3

# certwatch only needs to read packets. Grant the raw-capture capability
# instead of running as full root.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
User=certwatch
Group=certwatch

# Detection-only tool: lock the rest of the box down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_PACKET AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Bound RAM on the Zero 2W; flow state is small but cap it anyway.
MemoryMax=128M

# journald captures stdout (the JSON lines / triage records).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
