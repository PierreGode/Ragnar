[Unit]
# Ragnar wpswatch — passive WPS / Wi-Fi Simple Config posture + attack detector.
# OPT-IN. RX-only: it never transmits, derives no PINs, recovers no nonces.
# Granted CAP_NET_RAW only (read-only monitor socket) — NOT CAP_NET_ADMIN, so it
# cannot set monitor mode, channel or hop. YOU prepare the interface first:
#   sudo ip link set wlan1 down && sudo iw dev wlan1 set type monitor
#   sudo ip link set wlan1 up  && sudo iw dev wlan1 set channel 6
# A WPS survey wants band coverage; pair with an external hopper (isowatch's) or
# lock a channel and accept you inventory only the APs on it.
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin wpsmon
#   sudo mkdir -p /var/log/wpswatch && sudo chown wpsmon:wpsmon /var/log/wpswatch
#   sudo install -Dm644 python/wpswatch.example.json /etc/ragnar/wpswatch.json
#   sudo cp scripts/wpswatch.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/wpswatch.service   # set RAGNAR_WPS_IFACE
#   sudo systemctl enable --now wpswatch
#   journalctl -u wpswatch -f
Description=Ragnar wpswatch passive WPS/WSC posture + attack detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wpsmon
Group=wpsmon
WorkingDirectory=/home/ragnar/Ragnar/python
Environment=RAGNAR_WPS_IFACE=wlan1
ExecStartPre=/bin/mkdir -p /var/log/wpswatch
ExecStart=/usr/bin/python3 /home/ragnar/Ragnar/python/wpswatch.py \
    -i ${RAGNAR_WPS_IFACE} -c /etc/ragnar/wpswatch.json \
    --jsonl /var/log/wpswatch/alerts.jsonl
Restart=on-failure
RestartSec=5

# --- least privilege: sniff only (never sets radio state) -----------------
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/wpswatch
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
LockPersonality=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
